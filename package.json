    "@vitest/coverage-v8": "^2.0.5",
    "eslint": "^9.9.0",
    "fast-check": "^3.20.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20.17.0"
  },
  "packageManager": "pnpm@9.7.1"
}