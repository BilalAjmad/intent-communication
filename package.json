{
  "name": "intent",
  "version": "0.0.0",
  "private": true,
  "description": "Intent — browser-first SPA monorepo for closing the intent gap",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
