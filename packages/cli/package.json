{
  "name": "@intent/cli",
  "version": "0.1.0",
  "description": "Intent CLI: intent init, intent doctor, intent export",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "intent": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.esm.json && copy dist\\esm\\index.js dist\\index.mjs && rmdir /s /q dist\\esm",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@intent/adapters-node": "workspace:*",
    "@intent/core": "workspace:*",
    "@intent/engine": "workspace:*",
    "@intent/schema": "workspace:*",
    "@intent/skills": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "ora": "^8.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^2.0.5",
    "eslint": "^9.39.5",
    "fast-check": "^3.20.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.0.5"
  },
  "sideEffects": false
}