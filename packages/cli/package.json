{
  "name": "@intent/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Intent cli package",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "biome lint src/",
    "format": "biome format --write src/",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.7.5"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@intent/server": "workspace:*",
    "@intent/mcp-server": "workspace:*",
    "@intent/skills": "workspace:*",
    "@intent/scanner": "workspace:*"
  }
}