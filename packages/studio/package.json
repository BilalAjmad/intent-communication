{
  "name": "@intent/studio",
  "version": "0.1.0",
  "description": "Intent Studio: SPA shell, iframe preview, tool bar",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.esm.json && node -e \"const fs=require('fs');fs.copyFileSync('dist/esm/index.js','dist/index.mjs')\" && node -e \"const fs=require('fs');fs.rmSync('dist/esm',{recursive:true,force:true})\"",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "preview": "vite preview"
  },
  "dependencies": {
    "@intent/schema": "workspace:*",
    "@intent/core": "workspace:*",
    "@intent/engine": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^2.0.5",
    "eslint": "^9.39.5",
    "fast-check": "^3.20.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  },
  "sideEffects": false
}