{
  "name": "@intent/linter",
  "version": "0.0.0",
  "private": true,
  "description": "Intent linter package",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "biome lint src/",
    "format": "biome format --write src/",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "@biomejs/biome": "^1.9.4"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@intent/schema": "workspace:*"
  }
}