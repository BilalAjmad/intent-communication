{
  "name": "@intent/linter",
  "license": "MIT",
  "version": "0.1.0",
  "description": "Intent linter: M1 rules from design.md \u00c2\u00a79",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.esm.json && node -e \"const fs=require('fs');fs.copyFileSync('dist/esm/index.js','dist/index.mjs')\" && node -e \"const fs=require('fs');fs.rmSync('dist/esm',{recursive:true,force:true})\"",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@intent/schema": "workspace:*",
    "@intent/core": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "fast-check": "^3.20.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "sideEffects": false
}